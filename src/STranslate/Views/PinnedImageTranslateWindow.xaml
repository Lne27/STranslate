<Window
    x:Class="STranslate.Views.PinnedImageTranslateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cnvt="clr-namespace:STranslate.Converters"
    xmlns:control="clr-namespace:STranslate.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    xmlns:vm="clr-namespace:STranslate.ViewModels"
    x:Name="STPinnedImageTranslateWindow"
    Title="{DynamicResource ImageTranslate}"
    Width="600"
    Height="400"
    MinWidth="1"
    MinHeight="1"
    d:DataContext="{d:DesignInstance Type=vm:PinnedImageTranslateViewModel,
                                     IsDesignTimeCreatable=False}"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.InputBindings>
        <KeyBinding
            Key="Esc"
            Command="{Binding CloseCommand}"
            CommandParameter="{Binding ElementName=STPinnedImageTranslateWindow}" />
        <KeyBinding
            Key="{Binding HotkeySettings.ReExecuteOcrHotkey.Key, Converter={cnvt:StringToKeyBindingConverter}, ConverterParameter={x:Static cnvt:HotkeyMode.Key}}"
            Command="{Binding ReExecuteCommand}"
            Modifiers="{Binding HotkeySettings.ReExecuteOcrHotkey.Key, Converter={cnvt:StringToKeyBindingConverter}, ConverterParameter={x:Static cnvt:HotkeyMode.Modifiers}}" />
        <KeyBinding
            Key="{Binding HotkeySettings.SwitchImageHotkey.Key, Converter={cnvt:StringToKeyBindingConverter}, ConverterParameter={x:Static cnvt:HotkeyMode.Key}}"
            Command="{Binding SwitchImageCommand}"
            Modifiers="{Binding HotkeySettings.SwitchImageHotkey.Key, Converter={cnvt:StringToKeyBindingConverter}, ConverterParameter={x:Static cnvt:HotkeyMode.Modifiers}}" />
    </Window.InputBindings>

    <Window.Resources>
        <Style
            x:Key="PinnedToolbarIconButtonStyle"
            BasedOn="{StaticResource {x:Type control:IconButton}}"
            TargetType="{x:Type control:IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="#30FFFFFF" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IconSize" Value="16" />
            <Setter Property="ui:ControlHelper.CornerRadius" Value="16" />
        </Style>
        <Style
            x:Key="PinnedToolbarComboBoxStyle"
            BasedOn="{StaticResource {x:Type ComboBox}}"
            TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{DynamicResource STControlFontSize12}" />
            <Setter Property="MaxDropDownHeight" Value="320" />
        </Style>
        <DataTemplate x:Key="PinnedToolbarServiceComboBoxItemTemplate">
            <TextBlock
                FontSize="{DynamicResource STControlFontSize12}"
                Text="{Binding DisplayName}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </DataTemplate>
        <DataTemplate x:Key="PinnedToolbarDropdownDataComboBoxItemTemplate">
            <TextBlock
                FontSize="{DynamicResource STControlFontSize12}"
                Text="{Binding Display}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid x:Name="PART_ImageSurface" Panel.ZIndex="5">
            <control:ImageZoom
                x:Name="PART_ImageZoom"
                Panel.ZIndex="5"
                AlwaysHideZoomValueHint="True"
                DisableDoubleClickReset="True"
                IsPanAndZoomEnabled="False"
                OcrWords="{Binding OcrWords}"
                OverlayDocument="{Binding DisplayOverlayDocument}"
                Source="{Binding DisplayImage}">
                <control:ImageZoom.InputBindings>
                    <KeyBinding
                        Key="A"
                        Command="{Binding SelectAllTextCommand}"
                        CommandParameter="{Binding ElementName=PART_ImageZoom}"
                        Modifiers="Ctrl" />
                    <KeyBinding
                        Key="C"
                        Command="{Binding CopySelectedTextCommand}"
                        CommandParameter="{Binding ElementName=PART_ImageZoom}"
                        Modifiers="Ctrl" />
                </control:ImageZoom.InputBindings>
            </control:ImageZoom>

            <control:NoticeBar
                x:Name="PART_LocationNotice"
                Panel.ZIndex="15"
                Margin="12"
                MaxWidth="480"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                IsOpen="{Binding IsNoLocationInfoVisible, Mode=TwoWay}"
                Message="{DynamicResource NoLocationInfoMessageForImTrans}"
                Severity="Warning"
                Title="{DynamicResource NoLocationInfoTitle}" />

            <control:NoticeBar
                x:Name="PART_StatusNotice"
                Panel.ZIndex="16"
                Margin="12"
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                IsOpen="{Binding IsStatusVisible, Mode=TwoWay}"
                Message="{Binding StatusMessage}"
                Severity="{Binding StatusSeverity}" />

            <Border
                x:Name="PART_ExecutingOverlay"
                Panel.ZIndex="30"
                Background="#50000000"
                IsHitTestVisible="False"
                Visibility="{Binding IsExecuting, Converter={cnvt:BoolToVisibilityConverter}}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ui:ProgressRing
                        Width="42"
                        Height="42"
                        Margin="0,0,0,10"
                        IsActive="{Binding IsExecuting}" />
                    <TextBlock
                        MaxWidth="260"
                        HorizontalAlignment="Center"
                        FontSize="{DynamicResource STControlFontSize12}"
                        Foreground="White"
                        Text="{Binding ProcessRingText}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            x:Name="PART_ToolbarBorder"
            Panel.ZIndex="20"
            Margin="8,6"
            Padding="8,6"
            Background="#CC1F1F1F"
            CornerRadius="22"
            Visibility="{Binding IsToolbarVisible, Converter={cnvt:BoolToVisibilityConverter}}">
            <ikw:SimpleStackPanel
                x:Name="PART_ToolbarPanel"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <ComboBox
                    x:Name="PART_OcrEngineComboBox"
                    MaxWidth="140"
                    ItemTemplate="{StaticResource PinnedToolbarServiceComboBoxItemTemplate}"
                    ItemsSource="{Binding OcrEngines}"
                    SelectedItem="{Binding SelectedOcrEngine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource PinnedToolbarComboBoxStyle}"
                    ToolTip="{DynamicResource ImTranOcrService}" />
                <ComboBox
                    x:Name="PART_TranslateEngineComboBox"
                    MaxWidth="140"
                    ItemTemplate="{StaticResource PinnedToolbarServiceComboBoxItemTemplate}"
                    ItemsSource="{Binding TransCollectionView}"
                    SelectedItem="{Binding SelectedTranslateEngine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource PinnedToolbarComboBoxStyle}"
                    ToolTip="{DynamicResource ImTranService}" />
                <ComboBox
                    x:Name="PART_LayoutComboBox"
                    MaxWidth="100"
                    ItemTemplate="{StaticResource PinnedToolbarDropdownDataComboBoxItemTemplate}"
                    ItemsSource="{Binding DataProvider.LayoutAnalysisModes}"
                    SelectedValue="{Binding LayoutAnalysisMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value"
                    Style="{StaticResource PinnedToolbarComboBoxStyle}"
                    ToolTip="{DynamicResource ImageTranslateLayoutAnalysisToolTip}" />
                <ComboBox
                    x:Name="PART_OcrLanguageComboBox"
                    MaxWidth="100"
                    ItemTemplate="{StaticResource PinnedToolbarDropdownDataComboBoxItemTemplate}"
                    ItemsSource="{Binding DataProvider.LangEnums}"
                    SelectedValue="{Binding OcrLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value"
                    Style="{StaticResource PinnedToolbarComboBoxStyle}"
                    ToolTip="{DynamicResource RecognizeLanguage}" />
                <ComboBox
                    x:Name="PART_SourceLanguageComboBox"
                    MaxWidth="100"
                    ItemTemplate="{StaticResource PinnedToolbarDropdownDataComboBoxItemTemplate}"
                    ItemsSource="{Binding DataProvider.LangEnums}"
                    SelectedValue="{Binding SourceLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value"
                    Style="{StaticResource PinnedToolbarComboBoxStyle}"
                    ToolTip="{DynamicResource ImageTranslateLanguageIndependentToolTip}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource STControlFontSize14}"
                    Foreground="White"
                    Opacity="0.8"
                    Text="&gt;" />
                <ComboBox
                    x:Name="PART_TargetLanguageComboBox"
                    MaxWidth="100"
                    ItemTemplate="{StaticResource PinnedToolbarDropdownDataComboBoxItemTemplate}"
                    ItemsSource="{Binding DataProvider.LangEnums}"
                    SelectedValue="{Binding TargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedValuePath="Value"
                    Style="{StaticResource PinnedToolbarComboBoxStyle}"
                    ToolTip="{DynamicResource TranslateLanguage}" />
                <control:IconButton
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding ElementName=STPinnedImageTranslateWindow}"
                    Icon="{x:Static ui:FluentSystemIcons.Dismiss_20_Regular}"
                    Style="{StaticResource PinnedToolbarIconButtonStyle}"
                    ToolTip="{DynamicResource Close}" />
                <control:IconButton
                    Icon="{x:Static ui:FluentSystemIcons.ImageSplit_20_Regular}"
                    IsOn="{Binding IsShowingAnnotated}"
                    Style="{StaticResource PinnedToolbarIconButtonStyle}"
                    ToolTip="{DynamicResource ShowHideAnnotation}"
                    Type="Toggle" />
                <control:IconButton
                    Command="{Binding HideToolbarCommand}"
                    Icon="{x:Static ui:FluentSystemIcons.EyeOff_20_Regular}"
                    Style="{StaticResource PinnedToolbarIconButtonStyle}"
                    ToolTip="{DynamicResource ImageTranslatePinnedHideToolbar}" />
                <control:IconButton
                    Command="{Binding OpenSettingsCommand}"
                    Icon="{x:Static ui:FluentSystemIcons.Settings_20_Regular}"
                    Style="{StaticResource PinnedToolbarIconButtonStyle}"
                    ToolTip="{DynamicResource ImTranSettingsToolTip}" />
                <control:IconButton
                    Command="{Binding ReExecuteCommand}"
                    Icon="{x:Static ui:FluentSystemIcons.TextEffectsSparkle_20_Regular}"
                    Style="{StaticResource PinnedToolbarIconButtonStyle}"
                    ToolTip="{DynamicResource ImageTranslate}" />
            </ikw:SimpleStackPanel>
        </Border>
    </Grid>
</Window>
