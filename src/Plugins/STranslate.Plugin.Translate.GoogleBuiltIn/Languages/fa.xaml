<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="STranslate_Plugin_Translate_GoogleBuiltIn_RequestMode">حالت درخواست</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_GoogleBuiltIn_RequestMode_Description">درخواست سفارشی (Custom API) از یک سرویس پروکسی شخصی استفاده می‌کند. اتصال مستقیم به گوگل نیازمند دسترسی سیستم به شبکه گوگل است.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_GoogleBuiltIn_RequestMode_CustomApi">API سفارشی</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_GoogleBuiltIn_RequestMode_Direct">گوگل مستقیم</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_GoogleBuiltIn_ApiUrl">نشانی API</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_GoogleBuiltIn_ApiUrl_Description">نشانی کامل نقطه پایانی ترجمه پروکسی سازگار را وارد کنید، مانند https://example.deno.dev/translate.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_GoogleBuiltIn_ApiUrl_Invalid">یک نشانی API معتبر HTTP یا HTTPS وارد کنید.</sys:String>
</ResourceDictionary>
